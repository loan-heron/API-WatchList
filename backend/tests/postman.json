{
  "info": {
    "name": "WatchList API",
    "description": "Tests des routes de l'API WatchList",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4001"
    },
    {
      "key": "filmId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET - Liste des films",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/films",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"La reponse est un tableau\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET - Liste filtree SF vues",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/films?genre=SF&status=vu&sort=year",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films"],
          "query": [
            {
              "key": "genre",
              "value": "SF"
            },
            {
              "key": "status",
              "value": "vu"
            },
            {
              "key": "sort",
              "value": "year"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Tous les films sont SF et vus\", function () {",
              "    const films = pm.response.json();",
              "    films.forEach(function (film) {",
              "        pm.expect(film.genre).to.eql(\"SF\");",
              "        pm.expect(film.status).to.eql(\"vu\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET - Film existant",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/films/{{filmId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films", "{{filmId}}"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Un film est retourne\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"object\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET - Film introuvable",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/films/999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films", "999"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Le champ error est present\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"error\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST - Ajouter un film",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Interstellar",
              "type": "text"
            },
            {
              "key": "genre",
              "value": "SF",
              "type": "text"
            },
            {
              "key": "year",
              "value": "2014",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": [],
              "description": "Selectionnez une image JPEG, PNG, WEBP ou GIF"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/films",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const film = pm.response.json();",
              "",
              "pm.test(\"Le film contient les valeurs par defaut\", function () {",
              "    pm.expect(film.status).to.eql(\"aVoir\");",
              "    pm.expect(film.rating).to.eql(0);",
              "    pm.expect(film).to.have.property(\"id\");",
              "    pm.expect(film.image).to.match(/^images\\//);",
              "});",
              "",
              "pm.collectionVariables.set(\"filmId\", film.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST - Titre vide",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "",
              "type": "text"
            },
            {
              "key": "genre",
              "value": "SF",
              "type": "text"
            },
            {
              "key": "year",
              "value": "2014",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": [],
              "description": "Une image peut etre selectionnee pour le test"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/films",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Le champ error est present\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"error\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "PATCH - Modifier statut et note",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"vu\",\n  \"rating\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/films/{{filmId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "films", "{{filmId}}"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Statut 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const film = pm.response.json();",
              "pm.test(\"Les modifications sont appliquees\", function () {",
              "    pm.expect(film.status).to.eql(\"vu\");",
              "    pm.expect(film.rating).to.eql(4);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
